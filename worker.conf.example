# deskgrid-cloud worker config
# Place this file next to deskgrid-worker.exe and rename to worker.conf.
# Lines starting with # are comments. CLI args (--type, --gateway, ...)
# override these values.

# Worker type: code | doc | csv | image | audio | video
TYPE=code

# Gateway URL (the deskgrid-cloud main node)
GATEWAY=http://192.168.1.178:13000

# HMAC secret — MUST match the gateway's GATEWAY_HMAC_SECRET
# Get this from the operator who started the gateway.
GATEWAY_HMAC_SECRET=change-me-to-match-gateway

# Display name in the dashboard
WORKER_NAME=office-pc-02-code

# Bind address (0.0.0.0 = reachable from gateway on the LAN)
WORKER_HOST=0.0.0.0

# Listen port (leave empty to use the default for the type)
# code=3001, doc=3002, csv=3003, image=3004, audio=3005, video=3006
PORT=

# ---- Capability auto-detection (Phase 1) -----------------------------
# WORKER_MODEL_DIRS is a semicolon-separated list of directories to scan for
# model weights. Each *direct* child becomes a `model:<name>` capability that
# the gateway uses to hard-filter tasks requiring a specific model.
#   - subdirectories  → emit `model:<dirname>`
#   - *.safetensors / *.ckpt / *.pt / *.pth / *.bin / *.onnx / *.gguf → emit `model:<basename>`
# Example:
#   WORKER_MODEL_DIRS=E:\models\sdxl\weights;E:\models\controlnet\weights

# WORKER_CAPABILITIES is a comma-separated list of extra tags to advertise
# in addition to whatever the auto-detector finds. Use it to manually claim
# `model:<x>` for weights the scanner can't see, or to drop a capability
# the operator knows is broken.
# Example:
#   WORKER_CAPABILITIES=model:sdxl,model:controlnet